# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform working directory
.terraform/

# Terraform lock file (OPTIONAL)
# Keep this if working in team environments
# Remove comment to ignore it
# .terraform.lock.hcl

# Local environment files
.env
.env.*

# macOS
.DS_Store

# VS Code
.vscode/

# IntelliJ / JetBrains
.idea/

# Python cache
__pycache__/
*.pyc

# Lambda zip artifacts
*.zip